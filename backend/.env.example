DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=
AUTH_COOKIE_NAME=rolig_session
OPENAI_API_KEY=
AI_ANALYSIS_ENABLED=false
OPENAI_ANALYSIS_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
FEED_CACHE_TTL_SECONDS=60
MEDIA_ALLOWED_HOSTS=pub-example.r2.dev,media.rolig.app
CORS_ALLOWED_ORIGINS=https://rolig.vercel.app
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rolig-media
R2_QUARANTINE_BUCKET_NAME=rolig-media-quarantine
R2_PUBLIC_BASE_URL=https://pub-example.r2.dev
UPLOAD_URL_TTL_SECONDS=300
UPLOAD_RATE_LIMIT_PER_HOUR=20
UPLOAD_QUOTA_BYTES=1073741824
UPLOAD_IMAGE_MAX_BYTES=15728640
UPLOAD_VIDEO_MAX_BYTES=209715200
# Comma-separated Supabase auth user UUIDs. Empty disables demo uploads.
UPLOAD_ALLOWED_USER_IDS=
# Optional override. When blank, imageio-ffmpeg supplies a managed binary.
FFMPEG_BINARY=
