.DS_Store
*.log
.expo/
.vercel/
.idea/
.vscode/

# JavaScript / Expo build output
**/node_modules/
**/dist/
**/build/
**/web-build/
**/.cache/
**/*.tsbuildinfo

# Python build output and virtual environments
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.venv/
