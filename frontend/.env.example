# Public configuration only. Expo embeds EXPO_PUBLIC_* values in the app bundle.
# Never place OpenAI, Supabase service-role, R2, Render, or other secrets here.
# Upload authorization must come from a user session, never an EXPO_PUBLIC token.
EXPO_PUBLIC_API_URL=https://rolig-backend.onrender.com

# Public Supabase client configuration from Project Settings > API.
# Use only the publishable key (sb_publishable_...) or legacy anon key.
# Never use sb_secret_..., service_role, JWT signing secrets, or database credentials here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
